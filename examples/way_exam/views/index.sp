page "The Way Exam"
  card
    title "Examination of the Way"
    text "Answer the five questions below to test your mastery of the Slim-Pickins Way as documented in PRIMER.md and the Ode to Joy."
    section overview, "Exam Standards"
      grid metrics, columns: 2
        metric questions_count, "Total Questions"
        metric passing_score, "Passing Score"

  form to: "/grade", method: post
    group "Question 1 — Morphology"
      text "What is the core morphological rule of alt-slim-pickins?"
      choice q1, "Select your answer"
        option a, "A dot means data, a bare word is language."
        option b, "Attributes use colon qualifiers like :href."
        option c, "Double quotes for data, single quotes for words."
    group "Question 2 — Conditionals"
      text "How are conditionals idiomatically handled in slim-pickins?"
      choice q2, "Select your answer"
        option a, "Using standard Ruby if/else control tags with <% %>."
        option b, "Conditionals dissolve into vocabulary (like empty) describing the situation."
        option c, "Using ternary operators inside attribute strings."
    group "Question 3 — Subject Shifting"
      text "What happens when a collection is iterated via `each account`?"
      choice q3, "Select your answer"
        option a, "A global Ruby variable $account is set across all templates."
        option b, "You must qualify every child expression as account.balance."
        option c, "Child sentences resolve dotted attributes (e.g. .balance) directly on that account."
    group "Question 4 — Design Discipline"
      text "Where do visual styles belong according to the design discipline?"
      choice q4, "Select your answer"
        option a, "In tag style attributes on every DOM element."
        option b, "In theme roles and word variants, refusing raw inline styles."
        option c, "In global utility classes generated by a JS build pipeline."
    group "Question 5 — The Vocabulary"
      text "How many words comprise the alt-slim-pickins vocabulary?"
      choice q5, "Select your answer"
        option a, "53 words"
        option b, "102 words"
        option c, "64 words"
    actions
      button "Submit Exam for Grading"
